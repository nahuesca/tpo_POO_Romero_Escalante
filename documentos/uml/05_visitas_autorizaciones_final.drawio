<mxfile host="app.diagrams.net"><diagram id="d1" name="5. Visitas y autorizaciones — Diagrama de clases final (etapa 2)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1090" background="#0d0d0d" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="5. Visitas y autorizaciones — Diagrama de clases final (etapa 2)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="26" as="geometry"/></mxCell><mxCell id="subtitulo" value="Sin autorización vigente no se habilita el ingreso; una persona no puede entrar dos veces sin haber salido." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#bec8d7;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="20" as="geometry"/></mxCell><mxCell id="vecino" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Vecino&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;- documento: String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="116" height="53" as="geometry"/></mxCell><mxCell id="lote" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Lote&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;- numero: int&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;+ esTitularOResidente(vecino): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="213" height="78" as="geometry"/></mxCell><mxCell id="visit" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Visitante&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;- tipo: TipoVisitante" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="114" height="53" as="geometry"/></mxCell><mxCell id="auth" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Autorizacion&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ MAX_DIAS_RECURRENTE: int = 30&lt;br&gt;- fechaDesde: LocalDate&lt;br&gt;- fechaHasta: LocalDate&lt;br&gt;- horaDesde: int&lt;br&gt;- horaHasta: int&lt;br&gt;- recurrente: boolean&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ estaVigente(hoy, hora): boolean&lt;br&gt;(el constructor valida titular/residente,&lt;br&gt; fechas, franja y límite de 30 días)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="212" height="190" as="geometry"/></mxCell><mxCell id="reg" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;RegistroAcceso&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- fecha: LocalDate&lt;br&gt;- horaIngreso: int&lt;br&gt;- horaEgreso: int&lt;br&gt;- salio: boolean&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ registrarEgreso(hora): void&lt;br&gt;+ estaAbierto(): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="160" height="142" as="geometry"/></mxCell><mxCell id="guardia" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Guardia&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;- puesto: Puesto&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;+ registrarIngreso(autorizacion, hoy, hora)&lt;br&gt;+ registrarEgreso(registro, hora)&lt;br&gt;+ verificarAutorizacion(autorizacion, hoy, hora)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="245" height="110" as="geometry"/></mxCell><mxCell id="tipo" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;TipoVisitante&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;PARTICULAR&lt;br&gt;PROVEEDOR&lt;br&gt;PROVEEDOR_HABITUAL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0e281a;strokeColor=#4caf6a;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="153" height="101" as="geometry"/></mxCell><mxCell id="puesto" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Puesto&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;PORTERIA&lt;br&gt;RONDA&lt;br&gt;MONITOREO" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0e281a;strokeColor=#4caf6a;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1290" y="700" width="100" height="101" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorVisitas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#a07bff;margin:3px 0&quot;&gt;+ autorizarVisita(vecino, lote, ..., recurrente): Autorizacion&lt;br&gt;+ buscarAutorizacionVigente(documento): Autorizacion&lt;br&gt;+ registrarIngreso(guardia, documento): RegistroAcceso&lt;br&gt;+ registrarEgreso(guardia, documento): RegistroAcceso&lt;br&gt;+ consultarIngresosAbiertos(): List" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1632;strokeColor=#a07bff;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="480" y="700" width="298" height="133" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Nota de cambios&lt;/b&gt;&lt;br&gt;Cambios respecto del diagrama de la etapa 1: la franja horaria pasa a horas enteras (0 a 23) y la fecha de ingreso es la del reloj del sistema;&lt;br&gt;el constructor de Autorizacion valida todo (quien autoriza, fechas, franja, recurrente solo para proveedores habituales, máximo 30 días);&lt;br&gt;RegistroAcceso agrega salio/estaAbierto() para bloquear un segundo ingreso; Guardia.registrarIngreso() y verificarAutorizacion() quedan&lt;br&gt;implementados; se agrega ControladorVisitas (GRASP Controlador). Solo el guardia de portería puede registrar ingresos." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f5e6a8;" vertex="1" parent="1"><mxGeometry x="480" y="940" width="697" height="92" as="geometry"/></mxCell><mxCell id="n3" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=none;" edge="1" parent="1" source="vecino" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n4" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n3"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n5" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n3"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n6" value="autoriza" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n3"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n7" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=none;" edge="1" parent="1" source="lote" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n7"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n9" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n7"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoin