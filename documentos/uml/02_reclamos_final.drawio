<mxfile host="app.diagrams.net"><diagram id="d1" name="2. Reclamos — Diagrama de clases final (etapa 2)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" background="#0d0d0d" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="2. Reclamos — Diagrama de clases final (etapa 2)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="26" as="geometry"/></mxCell><mxCell id="subtitulo" value="El reclamo nace ABIERTO con la prioridad de su tipo y solo avanza al estado siguiente." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#bec8d7;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="20" as="geometry"/></mxCell><mxCell id="comparable" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Comparable&amp;lt;Reclamo&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;+ compareTo(otro: Reclamo): int" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="177" height="69" as="geometry"/></mxCell><mxCell id="reclamo" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Reclamo&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ HORAS_ESCALADO: int = 24&lt;br&gt;+ HORAS_REAPERTURA: int = 120&lt;br&gt;- numero: int&lt;br&gt;- horaCreacion: int&lt;br&gt;- tipo: TipoReclamo&lt;br&gt;- descripcion: String&lt;br&gt;- prioridad: Prioridad&lt;br&gt;- estado: EstadoReclamo&lt;br&gt;- horaResolucion: int&lt;br&gt;- escalado: boolean&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ cambiarEstado(nuevo, observacion, ahora): void&lt;br&gt;+ asignarResponsable(personal, ahora): void&lt;br&gt;+ reabrir(ahora): void&lt;br&gt;+ agregarComentario(autor, texto, ahora): void&lt;br&gt;+ debeEscalarse(ahora): boolean&lt;br&gt;+ escalar(): void&lt;br&gt;+ debeCerrarse(ahora): boolean&lt;br&gt;+ estaPendiente(): boolean&lt;br&gt;+ compareTo(otro): int {Comparable}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="560" y="230" width="264" height="350" as="geometry"/></mxCell><mxCell id="cambio" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CambioEstado&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- hora: int&lt;br&gt;- nuevoEstado: EstadoReclamo&lt;br&gt;- observacion: String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1050" y="140" width="175" height="85" as="geometry"/></mxCell><mxCell id="comentario" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Comentario&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- hora: int&lt;br&gt;- autor: Persona&lt;br&gt;- texto: String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1050" y="330" width="99" height="85" as="geometry"/></mxCell><mxCell id="lote" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Lote&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;- numero: int&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;+ crearReclamo(autor, tipo, desc, ahora)&lt;br&gt;+ esTitularOAutorizado(vecino)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="216" height="94" as="geometry"/></mxCell><mxCell id="vecino" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Vecino&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;- documento: String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="116" height="53" as="geometry"/></mxCell><mxCell id="personal" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Personal&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;+ actualizarReclamo(reclamo, estado, obs, ahora)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="262" height="69" as="geometry"/></mxCell><mxCell id="tipo" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;TipoReclamo&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;SEGURIDAD(ALTA)&lt;br&gt;MANTENIMIENTO(MEDIA)&lt;br&gt;CONVIVENCIA(BAJA)&lt;br&gt;ADMINISTRATIVO(BAJA)&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;+ getPrioridad(): Prioridad" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0e281a;strokeColor=#4caf6a;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1050" y="560" width="156" height="142" as="geometry"/></mxCell><mxCell id="estado" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;EstadoReclamo&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;ABIERTO&lt;br&gt;ASIGNADO&lt;br&gt;EN_CURSO&lt;br&gt;RESUELTO&lt;br&gt;CERRADO&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;+ siguiente(): EstadoReclamo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0e281a;strokeColor=#4caf6a;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1050" y="760" width="165" height="158" as="geometry"/></mxCell><mxCell id="prioridad" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Prioridad&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;ALTA&lt;br&gt;MEDIA&lt;br&gt;BAJA" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0e281a;strokeColor=#4caf6a;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1290" y="560" width="100" height="101" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorReclamos&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#a07bff;margin:3px 0&quot;&gt;+ presentarReclamo(vecino, lote, tipo, desc): Reclamo&lt;br&gt;+ asignarReclamo(admin, reclamo, empleado): void&lt;br&gt;+ actualizarEstado(empleado, reclamo, estado, obs): void&lt;br&gt;+ cerrarReclamo(reclamo, obs): void&lt;br&gt;+ reabrirReclamo(vecino, reclamo): void&lt;br&gt;+ agregarComentario(autor, reclamo, texto): void&lt;br&gt;+ consultarReclamosDe(vecino): List&amp;lt;Reclamo&amp;gt;&lt;br&gt;+ ejecutarReglasAutomaticas(): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1632;strokeColor=#a07bff;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="299" height="181" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Nota de cambios&lt;/b&gt;&lt;br&gt;Cambios respecto del diagrama de la etapa 1: tipo, prioridad y estado pasan a enum (TipoReclamo conoce su prioridad y&lt;br&gt;EstadoReclamo.siguiente() resuelve &amp;#x27;solo avanzar&amp;#x27;); el momento se guarda como hora del reloj del sistema (int); asignarResponsable()&lt;br&gt;también pasa el reclamo a ASIGNADO; se agregan debeEscalarse/escalar/debeCerrarse para las reglas automáticas (24 h y 5 días);&lt;br&gt;Comentario guarda su autor; ControladorReclamos (GRASP Controlador) agrega asignar, actualizar, cerrar, reabrir y consultar." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f5e6a8;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="668" height="92" as="geometry"/></mxCell><mxCell id="n3" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;dashed=1;endArrow=block;endFill=0;endSize=12;" edge="1" parent=