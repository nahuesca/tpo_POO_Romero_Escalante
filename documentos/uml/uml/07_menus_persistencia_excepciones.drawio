erticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="560" y="880" width="130" height="53" as="geometry"/></mxCell><mxCell id="ex0" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«Exception»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ReglaNegocioException&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#be981c;margin:3px 0&quot;&gt;+ ReglaNegocioException(mensaje)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="196" height="69" as="geometry"/></mxCell><mxCell id="ex1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;NoAutorizadoException&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1150" y="880" width="158" height="28" as="geometry"/></mxCell><mxCell id="ex2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;LimiteExcedidoException&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="880" y="880" width="168" height="28" as="geometry"/></mxCell><mxCell id="vpr" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;VentanaPrincipal&lt;/b&gt;&lt;br&gt;&lt;i&gt;extends JFrame implements ActionListener&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- barrio: Barrio&lt;br&gt;- archivo: ArchivoDatos&lt;br&gt;- consola: ConsolaGrafica&lt;br&gt;- lblFecha: JLabel&lt;br&gt;- txtSalida: JTextArea&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ actionPerformed(e: ActionEvent): void&lt;br&gt;- ingresarVecino(): void&lt;br&gt;- ingresarAdministrador(): void&lt;br&gt;- ingresarGuardia(): void&lt;br&gt;- ingresarEmpleado(): void&lt;br&gt;- avanzarTiempo(): void&lt;br&gt;- ejecutarReglasAutomaticas(): void&lt;br&gt;- guardar(): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="1020" width="330" height="270" as="geometry"/></mxCell><mxCell id="vrol" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;VentanaRol&lt;/b&gt;&lt;br&gt;&lt;i&gt;extends JFrame implements ActionListener&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- menu: MenuBase&lt;br&gt;- barrio: Barrio&lt;br&gt;- archivo: ArchivoDatos&lt;br&gt;- consola: ConsolaGrafica&lt;br&gt;- txtSalida: JTextArea&lt;br&gt;- botones: JButton[]&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ actionPerformed(e: ActionEvent): void&lt;br&gt;- guardar(): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="460" y="1020" width="330" height="190" as="geometry"/></mxCell><mxCell id="cgraf" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ConsolaGrafica&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- ventana: Component&lt;br&gt;- txtSalida: JTextArea&lt;hr size=&q