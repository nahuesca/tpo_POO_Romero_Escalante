<mxfile host="app.diagrams.net"><diagram id="d1" name="7. Menús, ventanas, persistencia y excepciones — Diagrama de clases (nuevo en la etapa 2)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1420" background="#0d0d0d" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="7. Menús, ventanas, persistencia y excepciones — Diagrama de clases (nuevo en la etapa 2)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="26" as="geometry"/></mxCell><mxCell id="subtitulo" value="Reemplazan a las &#x27;Pantalla&#x27; de la etapa 1. La interfaz gráfica (Swing) reutiliza los mismos menús: cada ventana arma un botón por opción. La persistencia usa serialización de objetos." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#bec8d7;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="20" as="geometry"/></mxCell><mxCell id="seccion_gui" value="Interfaz gráfica con Swing (nueva)" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#bec8d7;" vertex="1" parent="1"><mxGeometry x="20" y="955" width="600" height="22" as="geometry"/></mxCell><mxCell id="mbase" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;MenuBase&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;# barrio: Barrio&lt;br&gt;# consola: Consola&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ titulo(): String {abstract}&lt;br&gt;+ opciones(): String[] {abstract}&lt;br&gt;+ ejecutarOpcion(opcion): void {abstract}&lt;br&gt;+ ejecutar(): void&lt;br&gt;+ setConsola(consola): void&lt;br&gt;# pedirLote(): Lote&lt;br&gt;# pedirReclamo(): Reclamo