<mxfile host="app.diagrams.net"><diagram id="d1" name="3. Expensas y pagos — Diagrama de clases final (etapa 2)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1110" background="#0d0d0d" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="3. Expensas y pagos — Diagrama de clases final (etapa 2)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="26" as="geometry"/></mxCell><mxCell id="subtitulo" value="Los pagos se aplican primero a intereses y después a capital, empezando por la expensa más antigua." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#bec8d7;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="20" as="geometry"/></mxCell><mxCell id="lote" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Lote&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;- moroso: boolean&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;+ emitirExpensa(presupuesto): Expensa&lt;br&gt;+ registrarPago(importe, medio, fecha): Pago&lt;br&gt;+ corregirPago(pago, dif, motivo, fecha): void&lt;br&gt;+ contarPeriodosImpagos(hoy): int&lt;br&gt;+ calcularDeudaTotal(hoy): double" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="239" height="142" as="geometry"/></mxCell><mxCell id="presup" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;PresupuestoMensual&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- anio: int&lt;br&gt;- mes: int&lt;br&gt;- total: double&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ calcularExpensa(coeficiente): double&lt;br&gt;+ getPeriodo(): String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1050" y="300" width="209" height="126" as="geometry"/></mxCell><mxCell id="comparable" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Comparable&amp;lt;Expensa&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;+ compareTo(otra: Expensa): int" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="177" height="69" as="geometry"/></mxCell><mxCell id="expensa" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Expensa&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ TASA_MORA_MENSUAL: double = 0.03&lt;br&gt;+ DIA_VENCIMIENTO: int = 10&lt;br&gt;- importe: double&lt;br&gt;- vencimiento: LocalDate&lt;br&gt;- capitalPagado: double&lt;br&gt;- interesPagado: double&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ calcularSaldoCapital(): double&lt;br&gt;+ calcularMesesAtraso(hoy): int&lt;br&gt;+ calcularInteresMora(hoy): double&lt;br&gt;+ calcularInteresPendiente(hoy): double&lt;br&gt;+ calcularSaldo(hoy): double&lt;br&gt;+ estaPagada(): boolean&lt;br&gt;+ estaImpaga(hoy): boolean&lt;br&gt;+ imputar(monto, hoy): double&lt;br&gt;+ devolverCapital(monto): void&lt;br&gt;+ compareTo(otra): int {Comparable}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="560" y="220" width="230" height="302" as="geometry"/></mxCell><mxCell id="pago" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Pago&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- fecha: LocalDate&lt;br&gt;- importe: double&lt;br&gt;- medio: MedioPago&lt;br&gt;- expensasPagadas: List&amp;lt;Expensa&amp;gt;&lt;br&gt;- montosPagados: List&amp;lt;Double&amp;gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ agregarImputacion(expensa, monto): void&lt;br&gt;+ calcularImporteEfectivo(): double&lt;br&gt;+ devolver(monto): void&lt;br&gt;+ agregarAjuste(ajuste): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="231" height="190" as="geometry"/></mxCell><mxCell id="ajuste" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;AjustePago&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- fecha: LocalDate&lt;br&gt;- importe: double&lt;br&gt;- motivo: String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="110" height="85" as="geometry"/></mxCell><mxCell id="medio" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;MedioPago&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;EFECTIVO&lt;br&gt;TRANSFERENCIA&lt;br&gt;TARJETA" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0e281a;strokeColor=#4caf6a;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="330" y="780" width="115" height="101" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorExpensas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#a07bff;margin:3px 0&quot;&gt;+ emitirExpensas(anio, mes, presupuesto): int&lt;br&gt;+ registrarPago(lote, importe, medio, fecha): Pago&lt;br&gt;+ corregirPago(lote, pago, dif, motivo, fecha): void&lt;br&gt;+ consultarDeudas(numeroLote): List&amp;lt;Expensa&amp;gt;&lt;br&gt;+ verificarMorosidad(hoy): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1632;strokeColor=#a07bff;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="560" y="760" width="262" height="133" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Nota de cambios&lt;/b&gt;&lt;br&gt;Cambios respecto del diagrama de la etapa 1: el pago pertenece al lote y recuerda en qué expensas se aplicó y cuánto (así puede&lt;br&gt;corregirse con un ajuste sin borrarse); el estado de la expensa se calcula (ya no es un atributo) y calcularInteres() pasa a&lt;br&gt;calcularInteresMora(hoy) con más métodos de saldo (GRASP Experto); PresupuestoMensual guarda anio y mes; validarImporte() se hace en&lt;br&gt;Lote.registrarPago(); se agrega imputar() para aplicar un monto (primero interés, luego capital); ControladorExpensas agrega emitir y pagar." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f5e6a8;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="701" height="92" as="geometry"/></mxCell><mxCell id="n3" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;dashed=1;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="expensa" target="comparable"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n4" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;" edge="1" parent="1" source="lote" target="expensa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n4"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n6" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n4"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n7" value="expensas" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n4"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n8" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;" edge="1" parent="1" source="lote" target="pago"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="1" style="edgeLabel;html=1;align=center;vert