<mxfile host="app.diagrams.net"><diagram id="d1" name="6. Controladores y reportes — Diagrama de clases (nuevo en la etapa 2)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" background="#0d0d0d" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="6. Controladores y reportes — Diagrama de clases (nuevo en la etapa 2)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="26" as="geometry"/></mxCell><mxCell id="subtitulo" value="Cada caso de uso tiene su controlador (GRASP Controlador). Los menús y las ventanas cambian datos solo a través de ellos." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#bec8d7;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="20" as="geometry"/></mxCell><mxCell id="barrio" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Barrio&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;- ahora: int&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;+ hoy(): LocalDate&lt;br&gt;+ notificar(persona, mensaje): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="188" height="94" as="geometry"/></mxCell><mxCell id="crec" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorReclamos&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#a07bff;margin:3px 0&quot;&gt;+ presentarReclamo(...): Reclamo&lt;br&gt;+ asignarReclamo(...): void&lt;br&gt;+ ejecutarReglasAutomaticas(): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1632;strokeColor=#a07bff;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="235" height="101" as="geometry"/></mxCell><mxCell id="cexp" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorExpensas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#a07bff;margin:3px 0&quot;&gt;+ emitirExpensas(...): int&lt;br&gt;+ registrarPago(...): Pago&lt;br&gt;+ consultarDeudas(numeroLote): List&amp;lt;Expensa&amp;gt;&lt;br&gt;+ verificarMorosidad(hoy): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1632;strokeColor=#a07bff;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="256" height="117" as="geometry"/></mxCell><mxCell id="cman" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorMantenimiento&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#a07bff;margin:3px 0&quot;&gt;+ reportarFalla(codigo): Equipo&lt;br&gt;+ generarOrden(...): OrdenMantenimiento&lt;br&gt;+ revisarEquipos(): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1632;strokeColor=#a07bff;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="221" height="101" as="geometry"/></mxCell><mxCell id="cvis" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorVisitas&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#a07bff;margin:3px 0&quot;&gt;+ autorizarVisita(...): Autorizacion&lt;br&gt;+ registrarIngreso(...): RegistroAcceso&lt;br&gt;+ registrarEgreso(...): RegistroAcceso" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1632;strokeColor=#a07bff;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1190" y="110" width="205" height="101" as="geometry"/></mxCell><mxCell id="crep" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorReportes&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#a07bff;margin:3px 0&quot;&gt;+ reclamosPendientes(): List&amp;lt;Reclamo&amp;gt;&lt;br&gt;+ morosidadPorLote(hoy): List&amp;lt;Lote&amp;gt;&lt;br&gt;+ equiposFueraDeServicio(): List&amp;lt;Equipo&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1632;strokeColor=#a07bff;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="620" y="680" width="227" height="101" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«Comparator&amp;lt;Reclamo&amp;gt;»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ComparadorReclamos&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#be981c;margin:3px 0&quot;&gt;+ compare(a, b): int  // prioridad y antigüedad" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="238" height="69" as="geometry"/></mxCell><mxCell id="c2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«Comparator&amp;lt;Lote&amp;gt;»&lt;/i&gt;&lt;br&gt;&lt;b&gt