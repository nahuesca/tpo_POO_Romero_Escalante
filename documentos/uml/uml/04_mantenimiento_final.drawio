<mxfile host="app.diagrams.net"><diagram id="d1" name="4. Mantenimiento — Diagrama de clases final (etapa 2)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" background="#0d0d0d" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="4. Mantenimiento — Diagrama de clases final (etapa 2)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="26" as="geometry"/></mxCell><mxCell id="subtitulo" value="Equipo es abstracta: cada subclase decide la prioridad de su falla (polimorfismo, abierto/cerrado)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#bec8d7;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="20" as="geometry"/></mxCell><mxCell id="equipo" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Equipo&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- codigo: String&lt;br&gt;- sector: Sector&lt;br&gt;- instalacion: LocalDate&lt;br&gt;- estado: EstadoEquipo&lt;br&gt;- horaFalla: int&lt;br&gt;- avisoEnviado: boolean&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ prioridadFalla(fallasEnElSector): PrioridadOrden {abstract}&lt;br&gt;+ getTipo(): String {abstract}&lt;br&gt;+ requiereAviso(ahora): boolean&lt;br&gt;+ registrarFalla(ahora): void&lt;br&gt;+ cambiarEstado(nuevo, ahora): void&lt;br&gt;+ estaOperativo(): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="312" height="254" as="geometry"/></mxCell><mxCell id="camara" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Camara&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ HORAS_AVISO: int = 48&lt;br&gt;- resolucion: String&lt;br&gt;- diasGrabacion: int&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ prioridadFalla(fallas): PrioridadOrden {override}  // siempre ALTA&lt;br&gt;+ getTipo(): String {override}&lt;br&gt;+ requiereAviso(ahora): boolean {override}  // más de 48 h" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="150" y="460" width="341" height="142" as="geometry"/></mxCell><mxCell id="lumin" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Luminaria&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ MAX_FALLAS_NORMALES: int = 3&lt;br&gt;- tipoLampara: String&lt;br&gt;- potencia: double&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ prioridadFalla(fallas): PrioridadOrden {override}  // ALTA si más de 3&lt;br&gt;+ getTipo(): String {override}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="700" y="460" width="358" height="126" as="geometry"/></mxCell><mxCell id="orden" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;OrdenMantenimiento&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- numero: int&lt;br&gt;- horaApertura: int&lt;br&gt;- prioridad: PrioridadOrden&lt;br&gt;- descripcion: String&lt;br&gt;- cerrada: boolean&lt;br&gt;- fechaCierre: LocalDate&lt;br&gt;- descripcionReparacion: String&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ asignarEmpleado(empleado, ahora): void&lt;br&gt;+ cerrarOrden(tecnico, descripcion, fecha): void&lt;br&gt;+ estaCerrada(): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1090" y="230" width="250" height="206" as="geometry"/></mxCell><mxCell id="empleado" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;EmpleadoMantenimiento&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;- especialidad: String&lt;hr size=&quot;1&quot; style=&quot;border-color:#7d7d87;margin:3px 0&quot;&gt;+ registrarReparacion(orden, trabajo, fecha)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1e21;strokeColor=#7d7d87;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1090" y="560" width="232" height="78" as="geometry"/></mxCell><mxCell id="estado" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;EstadoEquipo&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;OPERATIVO&lt;br&gt;CON_FALLA&lt;br&gt;EN_REPARACION&lt;br&gt;FUERA_DE_SERVICIO" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0e281a;strokeColor=#4caf6a;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="140" height="117" as="geometry"/></mxCell><mxCell id="sector" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Sector&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;CALLES_INTERNAS&lt;br&gt;ACCESOS&lt;br&gt;ESPACIOS_COMUNES" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0e281a;strokeColor=#4caf6a;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="141" height="101" as="geometry"/></mxCell><mxCell id="prio" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;PrioridadOrden&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#4caf6a;margin:3px 0&quot;&gt;NORMAL&lt;br&gt;ALTA" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0e281a;strokeColor=#4caf6a;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1290" y="90" width="110" height="85" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«control»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorMantenimiento&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#a07bff;margin:3px 0&quot;&gt;+ reportarFalla(codigo): Equipo&lt;br&gt;+ generarOrden(codigo, descripcion): OrdenMantenimiento&lt;br&gt;+ asignarOrden(numero, empleado): void&lt;br&gt;+ cerrarOrden(numero, empleado, trabajo, fecha): void&lt;br&gt;+ cambiarEstadoEquipo(codigo, estado): void&lt;br&gt;+ revisarEquipos(): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#1e1632;strokeColor=#a07bff;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="460" y="760" width="305" height="149" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Nota de cambios&lt;/b&gt;&lt;br&gt;Cambios respecto del diagrama de la etapa 1: prioridadFalla() recibe la cantidad de equipos del mismo tipo y sector que fallan&lt;br&gt;(regla de las luminarias) y devuelve un enum; se agregan getTipo(), requiereAviso() y la hora de la falla para el aviso de la cámara a las&lt;br&gt;48 horas; OrdenMantenimiento suma número, equipo y asignarEmpleado(); cerrarOrden() exige fecha, técnico y descripción;&lt;br&gt;se agrega ControladorMantenimiento (GRASP Controlador), que no existía en la etapa 1." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f5e6a8;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="672" height="92" as="geometry"/></mxCell><mxCell id="n3" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="camara" target="equipo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n4" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="lumin" target="equipo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=none;" edge="1" parent="1" source="equipo" target="orden"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n5"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n7" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n5"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n8" value="órdenes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n5"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n9" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=none;" edge="1" parent="1" source="empleado" target="orden"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n9"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n11" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n9"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n12" value="técnico" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n9"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n13" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=open;endFill=0;" edge="1" parent="1" source="equipo" target="estado"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=open;endFill=0;" edge="1" parent="1" source="equipo" target="sector"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=open;endFill=0;" edge="1" parent="1" source="orden" target="prio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="ctrl" target="equipo"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>