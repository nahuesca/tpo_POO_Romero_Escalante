<mxfile host="app.diagrams.net"><diagram id="d1" name="1. Personas y lotes — Diagrama de clases final (etapa 2)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1240" background="#0d0d0d" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="1. Personas y lotes — Diagrama de clases final (etapa 2)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1460" height="26" as="geometry"/></mxCell><mxCell id="subtitulo" value="Jerarquía de herencia con sobreescritura de obtenerRol(). Barrio es la clase principal y crea los lotes." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#bec8d7;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1460" height="20" as="geometry"/></mxCell><mxCell id="persona" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Persona&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- nombre: String&lt;br&gt;- apellido: String&lt;br&gt;- documento: String&lt;br&gt;- telefono: String&lt;br&gt;- correo: String&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ obtenerRol(): String {abstract}&lt;br&gt;+ equals(otro: Object): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="590" y="80" width="174" height="174" as="geometry"/></mxCell><mxCell id="vecino" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Vecino&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- autorizadoReclamos: boolean&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ obtenerRol(): String {override}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="175" height="78" as="geometry"/></mxCell><mxCell id="visitante" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Visitante&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- tipo: TipoVisitante&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ obtenerRol(): String {override}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="175" height="78" as="geometry"/></mxCell><mxCell id="personal" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Personal&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- legajo: int&lt;br&gt;- fechaIngreso: LocalDate&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ obtenerRol(): String {override}&lt;br&gt;+ actualizarReclamo(reclamo, nuevoEstado, obs, ahora): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="690" y="330" width="319" height="126" as="geometry"/></mxCell><mxCell id="admin" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Administrador&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ obtenerRol(): String {override}&lt;br&gt;+ asignarReclamo(reclamo, empleado, ahora): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="440" y="640" width="268" height="69" as="geometry"/></mxCell><mxCell id="guardia" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Guardia&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;- turno: String&lt;br&gt;- puesto: Puesto&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ obtenerRol(): String {override}&lt;br&gt;+ verificarAutorizacion(autorizacion, hoy, hora): boolean&lt;br&gt;+ registrarIngreso(autorizacion, hoy, hora): RegistroAcceso&lt;br&gt;+ registrarEgreso(registro, hora): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="780" y="640" width="305" height="142" as="geometry"/></mxCell><mxCell id="empleado" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;EmpleadoMantenimiento&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ MAX_RECLAMOS_EN_CURSO: int = 5&lt;br&gt;- especialidad: String&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ obtenerRol(): String {override}&lt;br&gt;+ puedeTomarReclamo(reclamosActivos): boolean&lt;br&gt;+ registrarReparacion(orden, trabajo, fecha): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="1150" y="640" width="266" height="126" as="geometry"/></mxCell><mxCell id="lote" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Lote&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ MAX_PERIODOS_IMPAGOS: int = 3&lt;br&gt;- numero: int&lt;br&gt;- superficie: double&lt;br&gt;- moroso: boolean&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ calcularParticipacion(): double&lt;br&gt;+ esTitularOAutorizado(vecino): boolean&lt;br&gt;+ autorizarReclamante(quien, residente, autorizado): void&lt;br&gt;+ crearReclamo(autor, tipo, desc, ahora): Reclamo&lt;br&gt;+ emitirExpensa(presupuesto): Expensa&lt;br&gt;+ registrarPago(importe, medio, fecha): Pago&lt;br&gt;+ corregirPago(pago, dif, motivo, fecha): void&lt;br&gt;+ contarPeriodosImpagos(hoy): int&lt;br&gt;+ calcularDeudaTotal(hoy): double&lt;br&gt;+ determinarSiEsMoroso(hoy): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="298" height="270" as="geometry"/></mxCell><mxCell id="barrio" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Barrio&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ MAX_LOTES: int = 150&lt;br&gt;- nombre: String&lt;br&gt;- fechaInicio: LocalDate&lt;br&gt;- ahora: int&lt;hr size=&quot;1&quot; style=&quot;border-color:#3b82f6;margin:3px 0&quot;&gt;+ crearLote(numero, superficie, titular): Lote&lt;br&gt;+ buscarLote(numero): Lote&lt;br&gt;+ lotesDe(vecino): List&amp;lt;Lote&amp;gt;&lt;br&gt;+ avanzarHoras(horas): void&lt;br&gt;+ hoy(): LocalDate&lt;br&gt;+ horaDelDia(): int&lt;br&gt;+ notificar(persona, mensaje): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;spacingRight=4;fontSize=11;fontFamily=Helvetica;fillColor=#0d1b2e;strokeColor=#3b82f6;strokeWidth=2;fontColor=#f0f0f0;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="232" height="222" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Aclaraciones&lt;/b&gt;&lt;br&gt;Barrio es la raíz del modelo y lo que se guarda en el archivo.&lt;br&gt;Barrio–Lote es composición: el lote solo lo crea Barrio.crearLote()&lt;br&gt;y no existe sin el barrio (necesita su superficie total).&lt;br&gt;Barrio tiene también listas de vecinos, guardias, empleados,&lt;br&gt;visitantes, equipos, órdenes, autorizaciones, registros de&lt;br&gt;acceso, notificaciones y el administrador (1).&lt;br&gt;&lt;br&gt;Lote–residentes es agregación: el vecino existe antes y aparte del lote.&lt;br&gt;Un lote tiene un titular (1) y 0..* residentes (Vecino).&lt;br&gt;Una misma persona puede ser titular de varios lotes.&lt;br&gt;El reloj del sistema (ahora) cuenta horas; hoy() da la fecha." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f5e6a8;" vertex="1" parent="1"><mxGeometry x="1030" y="80" width="385" height="204" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Nota de cambios&lt;/b&gt;&lt;br&gt;Cambios respecto del diagrama de la etapa 1: Barrio pasa a ser la clase principal y crea los lotes (GRASP Creador); el coeficiente&lt;br&gt;de Lote ya no es un atributo sino calcularParticipacion(); crearReclamo recibe el autor y la hora; Vecino pierde presentarReclamo()&lt;br&gt;(el camino real es Controlador -&amp;gt; Lote.crearReclamo); Administrador pierde emitirReporte() (lo hace ControladorReportes);&lt;br&gt;Personal.actualizarReclamo() y Guardia.registrarIngreso() quedan implementados; tipos y estados pasan a enum; las horas son int.&lt;br&gt;Barrio–Lote pasa de agregación a composición: el lote lo crea el barrio (crearLote) y no puede existir sin él. Los residentes&lt;br&gt;siguen siendo agregación (cada Vecino se registra por separado y puede cambiar de lote)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fillColor=#2b2406;strokeColor=#be981c;strokeWidth=2;fontColor=#f5e6a8;" vertex="1" parent="1"><mxGeometry x="560" y="960" width="760" height="124" as="geometry"/></mxCell><mxCell id="n3" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="vecino" target="persona"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n4" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="visitante" target="persona"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="personal" target="persona"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="admin" target="personal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="guardia" target="personal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=block;endFill=0;endSize=12;" edge="1" parent="1" source="empleado" target="personal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;" edge="1" parent="1" source="barrio" target="lote"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n9"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n11" value="1..150" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n9"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n12" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;endArrow=none;" edge="1" parent="1" source="lote" target="vecino"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n12"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n14" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n12"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n15" value="titular" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n12"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n16" style="html=1;strokeColor=#cdd5e1;strokeWidth=2;fontColor=#bec8d7;fontSize=11;labelBackgroundColor=none;startArrow=diamondThin;startFill=0;startSize=16;endArrow=none;" edge="1" parent="1" source="lote" target="vecino"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="480"/></Array></mxGeometry></mxCell><mxCell id="n17" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n16"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n18" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n16"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n19" value="residentes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#bec8d7;labelBackgroundColor=none;" vertex="1" connectable="0" parent="n16"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>